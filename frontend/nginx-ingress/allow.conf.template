# Кто может обращаться к приложению напрямую.
#
# TLS терминирует обратный прокси перед нами (здесь — роутер), и это единственный
# клиент, который законно говорит с этим портом по открытому HTTP. Любое другое
# устройство в локальной сети, открывшее порт, получает приложение без
# сертификата: ссылка на http://<адрес-в-локалке>:3000 приводит на страницу
# входа, и пароль уходит тому, от кого сертификат как раз и защищал.
#
# INGRESS_ALLOW — настройка развёртывания, а не константа кода: адрес прокси
# свой на каждой установке. Значение по умолчанию в docker-compose оставляет
# прежнее поведение для тех, кто его не задаёт.
allow 127.0.0.1;
# Мосты Docker: сюда приходят запросы с самого хоста и из соседних контейнеров.
# Локальная сеть этим диапазоном не пользуется.
allow 172.16.0.0/12;
allow ${INGRESS_ALLOW};
deny all;
