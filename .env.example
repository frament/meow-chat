# Copy to .env and fill in. .env itself is gitignored - never commit it, this repo
# is public.

# Required. The server refuses to start without it, and there is deliberately no
# default: a built-in secret would be a secret in the source, and anyone reading
# the repo could mint a token for any user with is_admin: true.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Required for WebAuthn (biometric login) to work outside localhost: the RP ID is
# the domain, and it has to match what the browser sees.
WEBAUTHN_RP_ID=chat.frament.netcraze.link
WEBAUTHN_RP_ORIGIN=https://chat.frament.netcraze.link

# Contact shown in Web Push subscription requests. Has to be a real address to be
# reachable if something goes wrong with delivery.
VAPID_CONTACT=admin@gmail.com